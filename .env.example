SPARQL_ENDPOINT=https://sparql.mem.edufeed.org/sparql/

# Infrastructure graphs (required)
GRAPH_ONTOLOGY=https://w3id.org/lehrplan/ontology/1.0.0rc3
GRAPH_SCHULART=https://w3id.org/schulart/1.0.0
GRAPH_SCHULFACH=https://w3id.org/schulfach/1.0.0

# State graphs (add GRAPH_STATE_<CODE> for each state with data)
GRAPH_STATE_SN=https://w3id.org/lehrplan/data/sachsen/inferences
GRAPH_STATE_BY=http://by-2026-01-27/
GRAPH_STATE_RP=https://w3id.org/lehrplan/data/rlp/inferences
GRAPH_STATE_BE=https://w3id.org/lehrplan/data/berlin/inferences

# HTTP service mode (used with --http flag)
# PORT=3000
# API_KEY=your-secret-key-here
